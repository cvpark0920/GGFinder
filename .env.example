# GGFinder 로컬 Docker 테스트 환경 변수
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요

# ============================================
# 빌드 타임 환경 변수 (Docker 빌드 시 사용)
# ============================================

# 프론트엔드 API 기본 URL (빌드 타임에 프론트엔드에 포함됨)
VITE_API_BASE_URL=http://localhost:4000

# ============================================
# 런타임 환경 변수 (애플리케이션 실행 시 사용)
# ============================================

# Node.js 환경
NODE_ENV=production
PORT=4000

# 데이터베이스 연결 (docker-compose.yml에서 자동 생성됨)
# DATABASE_URL은 docker-compose.yml에서 자동으로 설정됩니다
# 필요시 직접 설정:
# DATABASE_URL=postgresql://app:app@db:5432/ggfinder?schema=public

# JWT 토큰 서명에 사용할 비밀 키
# 프로덕션에서는 강력한 랜덤 문자열을 사용하세요
# 예: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Google OAuth 설정 (선택사항 - 로컬 테스트 시 필요 없을 수 있음)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS 및 프론트엔드 URL 설정
CORS_ORIGIN=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# ============================================
# 데이터베이스 설정 (docker-compose.yml에서 사용)
# ============================================

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ggfinder
POSTGRES_PORT=5432
